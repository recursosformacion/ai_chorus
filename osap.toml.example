# Configuración propia de Chorus. Nunca incluir contraseñas ni secretos.
[auth]
# URL pública de osap-auth (sin /auth al final).
base_url = ""
timeout_seconds = 15

[osap]
# URL pública real de osap-api.
api_base_url = ""
timeout_seconds = 45

[editor]
# Completar con la URL y el origen exactos de la instancia desplegada de MuseEncore.
base_url = ""
origin = ""
source_token_ttl_seconds = 300

[storage]
database_path = "var/chorus.sqlite3"
root = "var/private"
max_upload_bytes = 52428800

[app]
# Orígenes de la web Chorus; el origen MuseEncore se añade para el endpoint temporal de fuente.
cors_origins = []
public_base_url = ""
secure_cookies = true
